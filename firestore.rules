rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /images/{key} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && key.matches('^[a-z0-9][a-z0-9-]*$')
        && request.resource.data.keys().hasOnly(['url', 'publicId', 'width', 'height', 'updatedAt'])
        && request.resource.data.url is string
        && request.resource.data.url.matches('^https://res[.]cloudinary[.]com/.*');
    }
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'rkzonio1@gmail.com'
        && request.auth.token.email_verified == true;
    }
  }
}
